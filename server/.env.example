PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_strong_random_jwt_secret

# Supabase (Backend ONLY - never expose service_role in client)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Automatic DDL (pick ONE - no manual SQL needed):
#   a) full Postgres URI from Settings > Database > Connection string
DATABASE_URL=
#   b) the raw database password (server builds the pooler/direct URI itself)
SUPABASE_DB_PASSWORD=
# Region of the Supabase project, used with SUPABASE_DB_PASSWORD (default ap-south-1)
SUPABASE_REGION=ap-south-1
#   c) personal access token (sbp_...) from supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Google Gemini AI (Backend ONLY - never put in client)
GEMINI_API_KEY=

# Ordered Gemini model preference (fastest / most reliable first).
# The server hedges across these, so extra entries only add resilience.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.8-flash,gemini-3.7-flash

# ---------------------------------------------------------------------------
# Redis / Render Key Value (OPTIONAL)
# ---------------------------------------------------------------------------
# Caches the public leaderboard (20s TTL) and identical AI prompts (6h TTL).
# Leave blank to disable - the API behaves identically, just without caching.
#
# On Render, copy the *internal* URL from your Key Value instance
# (redis://red-xxxx:6379). From outside Render use the *external* URL, which
# is TLS: rediss://red-xxxx:<password>@<region>-keyvalue.render.com:6379
REDIS_URL=
